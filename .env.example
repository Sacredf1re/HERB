# PostgreSQL connection string (Render Postgres "Internal Database URL" when deployed)
DATABASE_URL="postgresql://user:password@localhost:5432/wildroot?schema=public"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# The public URL of the deployed site (Render gives you this, e.g. https://wildroot.onrender.com)
NEXTAUTH_URL="http://localhost:3000"

# --- Payment gateway (not wired up yet) ---
# When you decide on a gateway (Stripe, PayPal, Mercado Pago, etc.) its keys go here.
# The checkout page is already built to read a "gateway connected" flag so you can
# drop in real payment logic later without restructuring anything.
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
